# NEXUS OS — local environment
# Copy to `.env` (gitignored) and fill in. Never commit real values.
#
# Every `Settings` field in `services/api/app/config.py` appears below, and
# nothing else does. `tests/test_config_gates.py` asserts both directions, so
# the two cannot drift — which they had: a required-looking
# `NEXUS_SESSION_SECRET` was documented here, pinned in `conftest.py`, and read
# by no line of code in the repository.
#
# Lines that are commented out are at their default. Uncomment only to change
# one. Lines with an empty value need something from you.

# The only variable with no default. A missing NEXUS_ENV used to mean `local`,
# which meant a deployment that forgot it served /docs publicly and set
# secure=False on both cookies. It is now a startup error. See ADR 0015.
#   local | ci | staging | production
NEXUS_ENV=local

# Debug logging. Off here on purpose: setup.ps1 copies this file verbatim, so a
# `true` becomes the default for everyone who never thought about it.
# NEXUS_DEBUG=false

# ── Database ────────────────────────────────────────────────
# Postgres with pgvector. Note the +asyncpg driver prefix.
#
# For the gate, do not set this by hand — `.\scripts\db-ci.ps1` builds a
# throwaway database from the CI image and points the shell at it (ADR 0014).
# For running the application:
#   Docker (ADR 0006, preferred):  .\scripts\db-docker.ps1 -Action up
#   Neon (ADR 0008, the target):   the connection string from the console
NEXUS_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/nexus

# A SECOND connection string, as the nexus_jobs role (ADR 0018, answering D24).
#
# Since migration 0013, domain_claim is row-level secured with a user_id
# predicate - so the expiry sweep, which spans every user, sees nothing as
# nexus_app and would match zero rows while logging a clean pass. nexus_jobs
# holds the one role-targeted policy that permits it, and is granted SELECT and
# UPDATE on that single table and nothing else.
#
# It is NOT privileged: NOSUPERUSER NOBYPASSRLS, verified in db/bootstrap.sql.
# Required outside local and ci, and the app REFUSES to start without it rather
# than falling back to nexus_app - a fallback would restore the silent failure
# the whole decision exists to prevent.
NEXUS_JOBS_DATABASE_URL=postgresql+asyncpg://nexus_jobs:PASSWORD@HOST:5432/nexus

# Whether THIS process runs the scheduled jobs. True on exactly one container -
# the worker - and false everywhere else.
#
# It used to be every API process, unconditionally. With one container that is
# untidy; with three behind a proxy it is three copies of every sweep, and
# because the jobs are idempotent rather than exclusive the symptom is triple
# the load and no error anybody sees. The other reason arrives later and harder:
# the embedding pass holds ~2 GB of weights resident, and that must not be the
# process answering requests.
#
# Leave it false locally unless you are testing the sweeps. docker-compose.yml
# sets it true on the worker and false on the api.
NEXUS_RUN_SCHEDULER=false

# Set this when the URL points at a transaction-mode pooler — PgBouncer, a
# Cloud SQL proxy, or Neon's `-pooler` endpoint. It disables client-side
# pooling and prepared-statement caching, without which asyncpg fails with
# `prepared statement ... does not exist` under concurrency only.
#
# It was previously inferred from `"-pooler" in url`, which is a guess about a
# hostname and silently false for every pooler but one.
# NEXUS_DB_TRANSACTION_POOLER=false

# Four timeouts, none of them redundant. See app/db.py for why each is needed.
# NEXUS_DB_STATEMENT_TIMEOUT=15s
# NEXUS_DB_LOCK_TIMEOUT=5s
# NEXUS_DB_IDLE_IN_TRANSACTION_TIMEOUT=30s
# NEXUS_DB_COMMAND_TIMEOUT_SECONDS=20.0
# NEXUS_DB_POOL_TIMEOUT_SECONDS=10.0

# The connection pool. Every value here costs whatever a round trip to the
# database costs, so the right numbers depend on where the database is —
# which is why these are settings rather than constants in app/db.py.
#
# Measured against the Neon instance this repo's .env points at (us-east-2,
# from a laptop): a cold connect is 7,148ms, a warm statement 529ms, and one
# argon2 password hash 19ms. A hash is 1/370th of a connection, which is why
# the breaking-point report's diagnosis of login latency as argon2 CPU was
# wrong: it was the pool.
#
# Size and overflow were 5 and 5. At half a second per statement one
# connection sustains ~2 statements/second, so ten connections capped the whole
# API at ~20 — a handful of concurrent requests. Twenty gives room; it buys
# concurrency, not latency.
# NEXUS_DB_POOL_SIZE=10
# NEXUS_DB_POOL_MAX_OVERFLOW=10

# Discard a pooled connection older than this, without asking the server. Was
# 300s, which sits *on* the boundary a managed provider closes idle
# connections at rather than inside it. The free half of staying ahead of a
# dead connection: an age check, no round trip.
# NEXUS_DB_POOL_RECYCLE_SECONDS=120

# Test a pooled connection before handing it to a request. **Set this to false
# when the database is in another region.** It is one round trip per request:
# measured at ~1.27s against us-east-2 (2,249ms with, 977ms without, for a
# checkout plus one statement) and about 2ms against a co-located database.
# That single line is most of the "4s to return a 409" in the report.
#
# It ships on because the safe default has to be the one that survives a
# provider closing a connection underneath us. Turning it off leaves
# NEXUS_DB_POOL_RECYCLE_SECONDS covering the ordinary idle-close; what it
# stops covering is a provider suspending its compute (Neon scales to zero),
# where the first request after a suspend fails once and then recovers.
# NEXUS_DB_POOL_PRE_PING=true

# Consumed by docker-compose.yml, not by the application. Generated by
# db-docker.ps1 on first `up`. Do not rotate these without `-Action reset`: the
# volume stores the password from first initialisation, so changing them here
# alone breaks the connection.
NEXUS_DB_SUPERUSER_PASSWORD=
NEXUS_APP_DB_PASSWORD=

# ── Sessions ────────────────────────────────────────────────
# There is deliberately no session secret. A session token is 256 bits of
# CSPRNG output and only its SHA-256 hash is stored, so presenting it is
# authenticated by the lookup itself — there is nothing for an HMAC to add.
# NEXUS_SESSION_COOKIE_NAME=nexus_session
# Twelve hours, and since P4 it **rolls**: any authenticated request with more
# than half the window spent extends it to a fresh twelve (doc/11 §5.2).
#
# Note what that costs, because the previous version of this comment claimed the
# opposite. "Short enough that a stolen cookie is not a standing credential" is
# only true of a fixed window. With a rolling one, a cookie in continuous use
# stays alive indefinitely - which is the point for a real user working a long
# day, and equally the point for whoever else has it. An absolute cap on top of
# the rolling window is the usual answer and is NOT implemented; see
# AUDIT-FINDINGS.md #17.
# NEXUS_SESSION_MAX_AGE_SECONDS=43200

# ── Secrets ─────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in staging and production — the app refuses to start without it
# there. Optional in local and ci so it can boot before storage exists.
NEXUS_STORAGE_SIGNING_SECRET=

# ── Local infrastructure substitutes (ADR 0001) ─────────────
NEXUS_STORAGE_BACKEND=filesystem
# `file` writes RFC-822 .eml files to NEXUS_MAIL_ROOT instead of sending them,
# which is what makes the whole verification and invitation chain testable with
# no provider and no account — D4 gates deployment, not development. A deployed
# environment refuses to start on `file`: it would write every verification
# email to a directory nobody reads, silently.
NEXUS_MAILER_BACKEND=file

# Both default to a directory inside the repository, which is gitignored.
# `conftest.py` overrides them so a readiness probe never writes into the
# working tree during a test.
# NEXUS_STORAGE_ROOT=.storage
# NEXUS_MAIL_ROOT=.mail
# How long a signed download URL stays valid.
# NEXUS_SIGNED_URL_TTL_SECONDS=300

# SMTP, for NEXUS_MAILER_BACKEND=smtp. Required in staging and production —
# `production` refuses the `file` backend outright, so a deployment cannot ship
# with mail going to a directory nobody reads.
#
# ── Gmail, for testing against a real inbox ──────────────────
# NEXUS_SMTP_HOST=smtp.gmail.com
# NEXUS_SMTP_PORT=587
# NEXUS_SMTP_USERNAME=you@gmail.com
# NEXUS_SMTP_PASSWORD=<16-character app password, NOT your account password>
# NEXUS_SMTP_FROM=NEXUS OS <you@gmail.com>
#
# The password must be a **Google app password**: Google Account -> Security ->
# 2-Step Verification -> App passwords. A normal account password is rejected
# with `535 5.7.8 BadCredentials`, and using one would hand this application
# your whole Google account rather than one narrow capability.
#
# Paste it **without spaces**. Google displays it as `abcd efgh ijkl mnop`; the
# spaces are for reading and the same `535` comes back if they are included.
#
# Gmail is right for testing and wrong for production: it rate-limits, sends
# from a personal identity, and mail from it to strangers lands in spam. A
# transactional provider (Resend, Postmark, SES) gives a verified sending
# domain and bounce handling — same five variables, no code change. That is D4.
#
# ── A local sink, to exercise the path with no credential ────
# Run `services/api/.venv/bin/python scripts/smtp_sink.py`, then:
# NEXUS_SMTP_HOST=127.0.0.1
# NEXUS_SMTP_PORT=1025
# NEXUS_SMTP_TLS=false
# STARTTLS. Off is permitted for a local relay and refused when deployed —
# without it the credentials and every single-use token cross the wire in clear.
# NEXUS_SMTP_TLS=true

# Where the links in those emails point. NOT derived from the request Host,
# which is attacker-controlled: a verification link built from it is a working
# account-takeover primitive. Must be https outside local and ci.
#
# **It must match wherever the web app actually runs.** The default pairs with
# `next dev -p 3000` in apps/web/package.json; change one and you must change
# the other, or every verification and password-reset link points at a dead port
# and the only symptom is a link that does nothing. Found exactly that way.
# NEXUS_PUBLIC_BASE_URL=http://localhost:3000

# ── Domain-check metering (finding #4) ──────────────────────
# /domains/{id}/check fetches a host the caller names, so it is metered per user
# and per domain. The per-domain ceiling must stay ABOVE the per-user one, or a
# single honest claimant is refused before any crowd is. Not settings today -
# the limits live in app/connectors/rate_limit.py; listed here so the shape is
# visible to whoever needs to tune them.

# ── Credential backoff (D14) ────────────────────────────────
# What a caller over the login or register limit is made to wait: doubling from
# base, capped. Never a 429 and never a lock - a 429 keyed by email announces
# that the address exists, and a lock is a denial-of-service vector against a
# named user. See app/routes/auth.py.
# NEXUS_LOGIN_BACKOFF_BASE_SECONDS=0.25
# NEXUS_LOGIN_BACKOFF_MAX_SECONDS=8.0

# ── Embeddings (ADR 0003) ───────────────────────────────────
# Local, free, no API key — document text is never sent anywhere to be
# embedded. ~2 GB downloaded on first run, and an optional extra: without
# `pip install -e ".[embeddings]"` documents still upload, parse, classify and
# reach the review queue, and /health/ready reports `embeddings: unconfigured`.
NEXUS_EMBEDDING_MODEL_ID=intfloat/multilingual-e5-large
NEXUS_EMBEDDING_DIM=1024
# NEXUS_MODEL_CACHE_DIR=models
# An environment-level off switch, distinct from the library being absent:
# "not installed yet" and "deliberately off" are different messages to a user.
# NEXUS_EMBEDDINGS_ENABLED=true

# ── Language model (ADR 0011) ───────────────────────────────
# The application runs perfectly well without a key. Leave it unset and AI
# features report `unavailable` while everything else works. Set it, then
# `pip install -e ".[ai]"` in services/api, to switch them on.
#
# This is the one secret that deliberately bypasses `Settings.require()`: an
# empty key is a supported operating state, not a misconfiguration.
# NEXUS_ANTHROPIC_API_KEY=
# NEXUS_ANTHROPIC_MODEL=claude-sonnet-4-5
# NEXUS_AI_ENABLED=true
# Per-skill kill switch, comma separated, so one misbehaving prompt can be
# stopped without taking down every AI feature.
# NEXUS_DISABLED_AI_SKILLS=

# The Nexus Assistant's input box, and the ask endpoint behind it. **Off, and
# off is the shipped default** (`doc/20` A8/A12). With this false the route
# returns 404 rather than 403 — the existence of an unreleased endpoint is
# itself information — and the panel stays reserved. The two move together.
# Turning it on is a decision with preconditions (`doc/20` §5 Q7).
# NEXUS_ASSISTANT_ENABLED=false

# ── Guardrails (doc 06 §8.4) ────────────────────────────────
# NEXUS_TENANT_DAILY_TOKEN_BUDGET=2000000
# NEXUS_USER_DAILY_TOKEN_BUDGET=200000

# ── Crawl budget (doc 06 §1.2) ──────────────────────────────
# Phase 2 retired the unauthenticated preview and with it both
# NEXUS_TRUSTED_PROXY_IPS (whose X-Forwarded-For to believe when rate-limiting
# an anonymous caller) and NEXUS_PREVIEW_TTL_HOURS (how long a crawled third
# party's data was kept). A crawl still needs bounding, so the rest survive
# on the research engine.
# NEXUS_CRAWL_MAX_BYTES=5000000
# NEXUS_CRAWL_TIMEOUT_SECONDS=15
# NEXUS_CRAWL_MAX_REDIRECTS=5

# ── Trusted proxies (ADR 0046, `doc/18` G6) ─────────────────
# NEXUS_TRUSTED_PROXY_IPS has a subject again: the anonymous Instant Gap
# Analysis scanner is an anonymous crawl, and its per-IP rate limit needs an
# address to key by. Comma-separated. Empty (the default) trusts nothing and
# uses the direct peer — safe, but every visitor behind a proxy shares one
# bucket. A deployment behind one (the Next.js BFF, in production) must set
# this to that proxy's own address.
# NEXUS_TRUSTED_PROXY_IPS=

# ── Not needed yet — listed so the shape is known ───────────
# These are not Settings fields. They are recorded here so the eventual shape
# of the environment is visible, and each is listed in `FUTURE` in
# `tests/test_config_gates.py` with the phase that will wire it up — so adding
# one here without saying why fails the build.
# Blocks Phase 11/16 · doc 05 §3.7 requires real keyword volumes, never estimated
# NEXUS_DATAFORSEO_LOGIN=
# NEXUS_DATAFORSEO_PASSWORD=
# Blocks Phase 18 (GA4 + Search Console OAuth, PageSpeed)
# NEXUS_GOOGLE_CLIENT_ID=
# NEXUS_GOOGLE_CLIENT_SECRET=
# NEXUS_PAGESPEED_API_KEY=

# ── Connectors — doc/14 step 9, ADR 0031 ────────────────────
# The spine is built and nothing can connect until these exist. Listed rather
# than invented: how a provider token is encrypted at rest is D27 and is Parul's
# to settle, and the HubSpot values come from a developer app nobody has
# registered yet.
#
# Encrypts provider refresh tokens at rest — **required in deployed
# environments**, beside NEXUS_DATABASE_URL and NEXUS_STORAGE_SIGNING_SECRET. A
# deployment without it refuses to boot, which is better than one that accepts
# an OAuth callback it cannot store.
#
# A Fernet key: 32 bytes, url-safe base64. Generate one with
#   services/api/.venv/bin/python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Losing it means every workspace reconnects — recoverable, and visibly so,
# which is more than can be said for a key that is present and wrong. Only the
# refresh token is sealed with it (ADR 0032); access tokens live in memory for
# the length of one sweep.
NEXUS_CONNECTOR_SECRET_KEY=
#
# HubSpot is step 9's provider: it publishes an official MCP server, and it is
# chosen ahead of accounting because D7 (whether Finance brings accounting in at
# all) is still open, so building that connector first would build on a decision
# nobody has made.
#
# Register an app at developers.hubspot.com. All three or none — two of the
# three fails at HubSpot rather than here, and the Connect button is hidden
# until all three are set. The redirect URI must match the app's registration
# character for character.
#
# Not required to boot: a deployment with no CRM connector simply has no Connect
# button for one, which is a supported state. The encryption key above is
# different, because its absence would let us accept an authorisation we cannot
# store.
#
# **The redirect URI is the web app's callback page, not the API's route.** Both
# complete the exchange; only one of them lands a person on a page rather than on
# a JSON document. It must match what is registered in HubSpot character for
# character, or the exchange fails at the vendor with a message about the
# redirect and nothing about why:
#
#     NEXUS_HUBSPOT_REDIRECT_URI=http://localhost:3001/connections/hubspot/callback
#
# NEXUS_HUBSPOT_CLIENT_ID=
# NEXUS_HUBSPOT_CLIENT_SECRET=
# NEXUS_HUBSPOT_REDIRECT_URI=

# NEXUS_PLATFORM_ADMIN_EMAILS — the interim gate on the billing rate card
# (`GET`/`PUT /admin/prices/...`). Comma-separated email addresses; absent means
# nobody is a platform admin and both endpoints 403 for everyone. A proper
# platform-admin role, independent of workspace membership, is a follow-up —
# see `app/config.py`.
#
# NEXUS_PLATFORM_ADMIN_EMAILS=
